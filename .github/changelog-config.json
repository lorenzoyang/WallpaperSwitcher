{
  "categories": [
    {
      "title": "Features",
      "labels": ["feature", "enhancement"]
    },
    {
      "title": "Bug Fixes",
      "labels": ["bug", "fix"]
    },
    {
      "title": "Maintenance",
      "labels": ["chore", "refactor", "dependencies"]
    },
    {
      "title": "Other Changes",
      "labels": []
    }
  ],
  "template": "## Release Notes\n\n${{CHANGELOG}}",
  "pr_template": "- ${{TITLE}} ([#${{NUMBER}}](${{URL}})) by @${{AUTHOR}}",
  "use_pull_requests": true,
  "ignore_pre_releases": true,
  "sort": "ASC"
}
